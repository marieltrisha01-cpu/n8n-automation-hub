    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GSHEETS_DOC_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Published_Ledger",
          "mode": "name"
        },
        "options": {}
      },
      "id": "node-gsheets-read-ledger",
      "name": "Google Sheets: Read Published Ledger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -700,
        220
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleApi": {
          "id": "CONFIGURE_GOOGLE_SERVICE_ACCOUNT",
          "name": "Google Service Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst pendingRows = $('Google Sheets: Read Pending Queue').all().map(i => i.json);\nconst ledgerRows = $input.all().map(i => i.json).filter(r => r && (r.content_hash || r.pinterest_pin_id));\n\nconst existingHashes = new Set(ledgerRows.map(r => String(r.content_hash || '').trim()).filter(Boolean));\nconst maxPins = Math.max(1, Number($env.MAX_PINS_PER_RUN || 1));\n\nconst results = [];\nlet acceptedCount = 0;\n\nfor (const row of pendingRows) {\n  const rowId = String(row.row_id || '').trim();\n  const topic = String(row.topic || '').trim();\n  const targetLink = String(row.target_link || '').trim();\n  const boardId = String(row.board_id || '').trim();\n\n  if (!rowId) throw new Error('Validation failed: row_id is required on every Content_Queue row.');\n  if (!topic || topic.length < 5) throw new Error(`Validation failed on row ${rowId}: topic must be >= 5 characters.`);\n  if (!/^https:\\/\\//i.test(targetLink)) throw new Error(`Validation failed on row ${rowId}: target_link must start with https://`);\n  if (!/^\\d+$/.test(boardId)) throw new Error(`Validation failed on row ${rowId}: board_id must be a numeric Pinterest board ID.`);\n\n  const normalizedSignature = `${topic.toLowerCase()}|${targetLink.toLowerCase()}|${boardId}`;\n  const contentHash = crypto.createHash('sha256').update(normalizedSignature).digest('hex').slice(0, 32);\n  const isDuplicate = existingHashes.has(contentHash);\n\n  if (isDuplicate) {\n    results.push({\n      json: {\n        ...row,\n        row_id: rowId,\n        topic,\n        target_link: targetLink,\n        board_id: boardId,\n        content_hash: contentHash,\n        is_duplicate: true\n      }\n    });\n    continue;\n  }\n\n  if (acceptedCount >= maxPins) {\n    continue;\n  }\n\n  existingHashes.add(contentHash);\n  acceptedCount += 1;\n  results.push({\n    json: {\n      ...row,\n      row_id: rowId,\n      topic,\n      target_link: targetLink,\n      board_id: boardId,\n      content_hash: contentHash,\n      is_duplicate: false\n    }\n  });\n}\n\nreturn results;"
      },
