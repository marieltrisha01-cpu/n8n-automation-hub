      "id": "node-if-pregenerated",
      "name": "IF Pre-Generated (Antigravity / Sheets AI)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        260,
        260
      ],
      "notes": "Skips external API call when pin_title, pin_description, and image_prompt were pre-filled by Antigravity or Google AI Pro in Sheets."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/models/' + ($env.GEMINI_MODEL || 'gemini-2.5-flash') + ':generateContent' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ systemInstruction: { parts: [{ text: 'You are an expert Pinterest SEO strategist and visual director. Return ONLY valid JSON with keys: pin_title (<=100 chars, front-loaded keyword), pin_description (150-480 chars, natural keywords + CTA + 3-5 hashtags), seo_keywords (comma-separated string of 8-12 long-tail keywords), alt_text (<=480 chars descriptive accessibility text), image_prompt (detailed vertical 2:3 editorial photography/graphic prompt for a 1000x1500 Pinterest pin, clean negative space, no gibberish text).' }] }, contents: [{ role: 'user', parts: [{ text: 'Generate Pinterest SEO content and visual prompt for topic: \"' + $json.topic + '\" linking to: ' + $json.target_link }] }], generationConfig: { temperature: 0.4, maxOutputTokens: 700, responseMimeType: 'application/json' } }) }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "node-gemini-generate",
      "name": "Gemini AI: Generate SEO Pin Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        380
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const original = $('Split In Batches (1 Pin)').item.json;\nconst inputJson = $input.item.json || {};\n\nlet parsed;\nif (inputJson.pin_title && inputJson.pin_description && inputJson.image_prompt) {\n  // Path 1: Pre-generated directly in Google Sheets by Antigravity or Google AI Pro\n  parsed = inputJson;\n} else {\n  // Path 2: Official Gemini API (generateContent) or Path 3: Anthropic/Cloudflare fallback\n  const geminiText = inputJson?.candidates?.[0]?.content?.parts?.[0]?.text;\n  const anthropicText = inputJson?.content?.[0]?.text;\n  const rawText = String(geminiText || anthropicText || '');\n  const cleaned = rawText.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```$/i, '').trim();\n\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (err) {\n    throw new Error(`AI returned non-JSON payload: ${err.message}. Raw: ${cleaned.slice(0, 200)}`);\n  }\n}\n\nconst pinTitle = String(parsed.pin_title || '').trim();\nconst pinDescription = String(parsed.pin_description || '').trim();\nconst seoKeywords = Array.isArray(parsed.seo_keywords)\n  ? parsed.seo_keywords.join(', ')\n  : String(parsed.seo_keywords || '').trim();\nconst altText = String(parsed.alt_text || '').trim();\nconst imagePrompt = String(parsed.image_prompt || '').trim();\n\nif (!pinTitle || pinTitle.length > 100) {\n  throw new Error(`SEO Validation failed: pin_title must be 1-100 chars (got ${pinTitle.length}).`);\n}\nif (pinDescription.length < 50 || pinDescription.length > 500) {\n  throw new Error(`SEO Validation failed: pin_description must be 50-500 chars (got ${pinDescription.length}).`);\n}\nif (!seoKeywords) {\n  throw new Error('SEO Validation failed: seo_keywords cannot be empty.');\n}\nif (!altText || altText.length > 500) {\n  throw new Error(`SEO Validation failed: alt_text must be 1-500 chars (got ${altText.length}).`);\n}\nif (imagePrompt.length < 20) {\n  throw new Error('SEO Validation failed: image_prompt must be >= 20 characters.');\n}\n\nreturn [{\n  json: {\n    ...original,\n    pin_title: pinTitle,\n    pin_description: pinDescription,\n    seo_keywords: seoKeywords,\n    alt_text: altText,\n    image_prompt: imagePrompt\n  }\n}];"
      },
