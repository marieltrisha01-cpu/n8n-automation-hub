      "id": "node-gsheets-read-queue",
      "name": "Google Sheets: Read Pending Queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -940,
        220
      ],
      "alwaysOutputData": false,
      "credentials": {
