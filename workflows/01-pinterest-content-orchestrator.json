    {
      "parameters": {
        "jsCode": "const pinData = $('Validate SEO & Schema Fields').item.json;\nconst media = $input.item.json;\n\nif (!media || !/^https:\\/\\//i.test(String(media.image_url || ''))) {\n  throw new Error(`Image hosting failed: invalid image_url (${media?.image_url}).`);\n}\nif (Number(media.width) !== 1000 || Number(media.height) !== 1500) {\n  throw new Error(`Image dimension check failed: expected 1000x1500, got ${media.width}x${media.height}.`);\n}\n\nreturn [{\n  json: {\n    ...pinData,\n    image_url: media.image_url,\n    image_width: 1000,\n    image_height: 1500\n  }\n}];"
      },
