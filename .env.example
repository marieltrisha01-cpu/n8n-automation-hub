# ─────── Created: 2026-11-14 | Purpose: Environment Variables Template for n8n Pinterest Automation | Last verified with: n8n 2.32.5 ───────
# Copy this file to .env for local testing or configure each variable as a Repository Secret in Hugging Face Spaces.
# NEVER commit real secrets or API keys to Git.

# --- 1. Neon Free PostgreSQL (24/7 Persistent State) ---
# Obtain from https://neon.tech -> Project -> Connection Details (Postgres connection URI)
DATABASE_URL=
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# --- 2. n8n Core Security & Execution Controls ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Asia/Manila
N8N_PORT=7860
N8N_PROXY_HOPS=1

# Initial Testing Safety Gates (keep MAX_PINS_PER_RUN=1 and REQUIRE_APPROVAL=true until first Pin succeeds)
MAX_PINS_PER_RUN=1
REQUIRE_APPROVAL=true

# --- 3. Google Sheets Content Database ---
# Copy the Spreadsheet ID from https://docs.google.com/spreadsheets/d/<GSHEETS_DOC_ID>/edit
GSHEETS_DOC_ID=

# --- 4. Hybrid Gemini API + Antigravity Content Generation ($0) ---
# Obtain a 100% free API key at https://aistudio.google.com/apikey (no credit card required).
# Note: Rows pre-filled by Antigravity IDE or Gemini in Google Sheets (Google AI Pro) skip this API call automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 5. Cloudflare Media Worker & R2 Hosting (1000x1500 Images + Keep-Alive Cron) ---
# Deploy cloudflare-worker/ and paste your *.workers.dev URL and custom bearer secret
CF_MEDIA_WORKER_URL=
CF_WORKER_SECRET=
R2_PUBLIC_BASE_URL=

# --- 6. Pinterest Official API v5 ---
# Obtain from https://developers.pinterest.com/apps/ (Business Account required; free)
# Use "sandbox" (https://api-sandbox.pinterest.com) for initial dry tests or "production" (https://api.pinterest.com) for live boards
PINTEREST_ENV=sandbox
PINTEREST_API_BASE_URL=https://api-sandbox.pinterest.com
PINTEREST_ACCESS_TOKEN=

# --- 7. Telegram Approval Gate & Error Notifications ---
# Bot token from @BotFather; Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
